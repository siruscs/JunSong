<view class="page"><view class="hero"><view class="hero-main"><view class="eyebrow">库存盘点</view><view class="hero-title">{{a}}</view></view><view wx:if="{{b}}" class="hero-badge"><text class="hero-badge-num">{{c}}</text><text class="hero-badge-label">进行中</text></view></view><scroll-view scroll-x class="tab-bar" show-scrollbar="{{false}}"><view class="{{['tab-item', d && 'active']}}" bindtap="{{e}}"><text>全部</text></view><view wx:for="{{f}}" wx:for-item="opt" wx:key="b" class="{{['tab-item', opt.c && 'active']}}" bindtap="{{opt.d}}"><text>{{opt.a}}</text></view></scroll-view><scroll-view scroll-y class="scroll" refresher-enabled refresher-triggered="{{o}}" bindrefresherrefresh="{{p}}" bindscrolltolower="{{q}}"><view wx:for="{{g}}" wx:for-item="item" wx:key="j" class="task-card" hover-class="task-card--active" bindtap="{{item.k}}"><view class="task-card-head"><text class="task-title">{{item.a}}</text><text class="{{['task-status', item.c]}}">{{item.b}}</text></view><view class="task-card-meta"><text class="task-dept">{{item.d}}</text><text wx:if="{{item.e}}" class="task-source">盘点人：{{item.f}}</text></view><view class="task-card-foot"><text class="task-time">{{item.g}}</text><text wx:if="{{item.h}}" class="task-time">过账：{{item.i}}</text></view></view><view wx:if="{{h}}" class="load-error"><view class="empty-title">盘点任务加载失败</view><view class="empty-subtitle">{{i}}</view><button class="retry-button" bindtap="{{j}}">重新加载</button></view><view wx:if="{{k}}" class="empty"><view class="empty-mark">盘</view><view class="empty-title">暂无盘点任务</view><view class="empty-subtitle">{{l}}</view></view><view wx:if="{{m}}" class="loading">加载中</view><view wx:if="{{n}}" class="loading">没有更多了</view></scroll-view></view>