<view class="page"><view class="hero"><view class="hero-main"><view class="eyebrow">经营任务</view><view class="hero-title">{{a}}</view></view><view wx:if="{{b}}" class="hero-badge"><text class="hero-badge-num">{{c}}</text><text class="hero-badge-label">待办</text></view></view><view class="tab-bar"><view class="{{['tab-item', f && 'active']}}" bindtap="{{g}}"><text>待处理</text><text wx:if="{{d}}" class="tab-count">{{e}}</text></view><view class="{{['tab-item', j && 'active']}}" bindtap="{{k}}"><text>我负责</text><text wx:if="{{h}}" class="tab-count">{{i}}</text></view><view class="{{['tab-item', l && 'active']}}" bindtap="{{m}}"><text>已完成</text></view></view><scroll-view scroll-y class="scroll" refresher-enabled refresher-triggered="{{w}}" bindrefresherrefresh="{{x}}" bindscrolltolower="{{y}}"><view wx:for="{{n}}" wx:for-item="item" wx:key="m" class="task-card" hover-class="task-card--active" bindtap="{{item.n}}"><view class="task-card-head"><text class="{{['task-title', item.b && 'overdue']}}">{{item.a}}</text><text class="{{['task-priority', item.d]}}">{{item.c}}</text></view><view class="task-card-meta"><text class="task-dept">{{item.e}}</text><text class="task-source">{{item.f}}</text></view><view class="task-card-foot"><text class="{{['task-status', item.h]}}">{{item.g}}</text><text class="{{['task-due', item.j && 'overdue']}}">{{item.i}}</text><text wx:if="{{item.k}}" class="task-assignee">{{item.l}}</text></view></view><view wx:if="{{o}}" class="load-error"><view class="empty-title">任务加载失败</view><view class="empty-subtitle">{{p}}</view><button class="retry-button" bindtap="{{q}}">重新加载</button></view><view wx:if="{{r}}" class="empty"><view class="empty-mark">务</view><view class="empty-title">暂无经营任务</view><view class="empty-subtitle">{{s}}</view></view><view wx:if="{{t}}" class="loading">加载中</view><view wx:if="{{v}}" class="loading">没有更多了</view></scroll-view><view wx:if="{{z}}" class="detail-mask" bindtap="{{A}}"></view><view wx:if="{{B}}" class="detail-panel"><view class="detail-header"><text class="detail-title">任务详情</text><text class="detail-close" bindtap="{{C}}">×</text></view><scroll-view wx:if="{{D}}" scroll-y class="detail-scroll"><view class="detail-section"><text class="detail-label">标题</text><text class="detail-value">{{E}}</text></view><view class="detail-section"><text class="detail-label">来源</text><text class="detail-value">{{F}} / {{G}}</text></view><view class="detail-section"><text class="detail-label">门店</text><text class="detail-value">{{H}}</text></view><view class="detail-section"><text class="detail-label">优先级</text><text class="{{['detail-value', J]}}">{{I}}</text></view><view class="detail-section"><text class="detail-label">状态</text><text class="{{['detail-value', L]}}">{{K}}</text></view><view class="detail-section"><text class="detail-label">负责人</text><text class="detail-value">{{M}}</text></view><view class="detail-section"><text class="detail-label">截止时间</text><text class="{{['detail-value', O && 'overdue']}}">{{N}}</text></view><view wx:if="{{P}}" class="detail-section"><text class="detail-label">影响金额</text><text class="detail-value money">¥{{Q}}</text></view><view wx:if="{{R}}" class="detail-section"><text class="detail-label">处理备注</text><text class="detail-value">{{S}}</text></view><view wx:if="{{T}}" class="detail-section"><text class="detail-label">驳回原因</text><text class="detail-value">{{U}}</text></view></scroll-view><view wx:if="{{V}}" class="detail-actions"><button wx:if="{{W}}" class="action-btn claim" disabled="{{Y}}" catchtap="{{Z}}">{{X}}</button><button wx:if="{{aa}}" class="action-btn complete" disabled="{{ac}}" catchtap="{{ad}}">{{ab}}</button><button wx:if="{{ae}}" class="action-btn reject" disabled="{{ag}}" catchtap="{{ah}}">{{af}}</button><button wx:if="{{ai}}" class="action-btn reopen" disabled="{{ak}}" catchtap="{{al}}">{{aj}}</button><button wx:if="{{am}}" class="action-btn source" catchtap="{{an}}">查看来源</button></view></view></view>