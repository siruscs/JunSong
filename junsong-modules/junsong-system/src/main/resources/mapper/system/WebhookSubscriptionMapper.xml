<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.junsong.system.mapper.WebhookSubscriptionMapper">

    <resultMap type="WebhookSubscription" id="WebhookSubscriptionResult">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="subscriptionName" column="subscription_name"/>
        <result property="eventType" column="event_type"/>
        <result property="callbackUrl" column="callback_url"/>
        <result property="secretToken" column="secret_token"/>
        <result property="status" column="status"/>
        <result property="maxRetries" column="max_retries"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectWebhookSubscriptionVo">
        select id, tenant_id, subscription_name, event_type, callback_url, secret_token, status, max_retries, del_flag, create_by, create_time, update_by, update_time, remark
        from webhook_subscription
    </sql>

    <select id="selectWebhookSubscriptionList" parameterType="WebhookSubscription" resultMap="WebhookSubscriptionResult">
        <include refid="selectWebhookSubscriptionVo"/>
        <where>
            del_flag = '0'
            <if test="subscriptionName != null and subscriptionName != ''">and subscription_name like concat('%', #{subscriptionName}, '%')</if>
            <if test="eventType != null and eventType != ''">and event_type = #{eventType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by id desc
    </select>

    <select id="selectWebhookSubscriptionById" parameterType="Long" resultMap="WebhookSubscriptionResult">
        <include refid="selectWebhookSubscriptionVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectActiveSubscriptionsByEventType" parameterType="String" resultMap="WebhookSubscriptionResult">
        <include refid="selectWebhookSubscriptionVo"/>
        where event_type = #{eventType} and status = '0' and del_flag = '0'
    </select>

    <insert id="insertWebhookSubscription" parameterType="WebhookSubscription" useGeneratedKeys="true" keyProperty="id">
        insert into webhook_subscription
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="subscriptionName != null and subscriptionName != ''">subscription_name,</if>
            <if test="eventType != null and eventType != ''">event_type,</if>
            <if test="callbackUrl != null and callbackUrl != ''">callback_url,</if>
            <if test="secretToken != null and secretToken != ''">secret_token,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="maxRetries != null">max_retries,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="subscriptionName != null and subscriptionName != ''">#{subscriptionName},</if>
            <if test="eventType != null and eventType != ''">#{eventType},</if>
            <if test="callbackUrl != null and callbackUrl != ''">#{callbackUrl},</if>
            <if test="secretToken != null and secretToken != ''">#{secretToken},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="maxRetries != null">#{maxRetries},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateWebhookSubscription" parameterType="WebhookSubscription">
        update webhook_subscription
        <trim prefix="SET" suffixOverrides=",">
            <if test="subscriptionName != null and subscriptionName != ''">subscription_name = #{subscriptionName},</if>
            <if test="eventType != null and eventType != ''">event_type = #{eventType},</if>
            <if test="callbackUrl != null and callbackUrl != ''">callback_url = #{callbackUrl},</if>
            <if test="secretToken != null and secretToken != ''">secret_token = #{secretToken},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="maxRetries != null">max_retries = #{maxRetries},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWebhookSubscriptionById" parameterType="Long">
        update webhook_subscription set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteWebhookSubscriptionByIds" parameterType="Long">
        update webhook_subscription set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
