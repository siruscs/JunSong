        "security": [{ "appKeySignature": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/open/apps": {
      "get": {
        "operationId": "listOpenApps",
        "summary": "查询授权应用列表",
        "tags": ["foundation"],
        "security": [{ "appKeySignature": [] }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/open/apps/{appId}/keys": {
      "get": {
        "operationId": "listAppKeys",
        "summary": "查询应用 Key 概览（脱敏）",
        "tags": ["foundation"],
        "security": [{ "appKeySignature": [] }],
        "parameters": [
          { "name": "appId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/open/webhooks/subscriptions": {
      "post": {
        "operationId": "createWebhookSubscription",
        "summary": "登记 Webhook 回调地址和事件订阅",
        "tags": ["foundation"],
        "security": [{ "appKeySignature": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "callbackUrl": { "type": "string", "format": "uri", "description": "回调地址" },
                  "events": { "type": "array", "items": { "type": "string" }, "description": "订阅事件列表" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "业务状态码，0 表示成功" },
          "message": { "type": "string", "description": "提示信息" },
          "data": { "description": "响应数据" },
          "requestId": { "type": "string", "description": "请求唯一标识" },
          "traceId": { "type": "string", "description": "链路追踪标识（可选）" }
        },
        "required": ["code", "message", "requestId"]
      },
      "PageResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "业务状态码，0 表示成功" },
          "message": { "type": "string" },
          "total": { "type": "integer", "format": "int64", "description": "总记录数" },
          "rows": { "type": "array", "items": {}, "description": "数据列表" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "message", "total", "rows", "requestId"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "业务错误码" },
          "message": { "type": "string", "description": "错误描述" },
          "errorCode": { "type": "string", "description": "机器可读错误码，如 OPEN_AUTH_SIGNATURE_INVALID" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "message", "requestId"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "认证失败：签名错误、时间戳过期、Nonce 重放或缺失请求头",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "权限不足：缺少所需 scope 或租户上下文",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "securitySchemes": {
      "appKeySignature": {
        "type": "apiKey",
        "name": "X-App-Key",
        "in": "header",
        "description": "HMAC-SHA256 签名认证。需同时传递 X-App-Key、X-App-Timestamp、X-App-Nonce、X-App-Signature 四个请求头。"
      }
    }
  }
}
