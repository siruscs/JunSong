<view wx:if="{{a}}" class="page data-v-f689bf8e"><view class="hero data-v-f689bf8e"><text class="title data-v-f689bf8e">会员商品销售政策</text><text class="subtitle data-v-f689bf8e">{{b}} · 每个核算周期、每个商品独立维护</text></view><view class="actions data-v-f689bf8e"><button wx:if="{{c}}" class="primary data-v-f689bf8e" bindtap="{{d}}">＋ 新增销售政策</button><button class="data-v-f689bf8e" bindtap="{{e}}">刷新</button></view><view wx:for="{{f}}" wx:for-item="row" wx:key="j" class="card data-v-f689bf8e"><view class="row-head data-v-f689bf8e"><text class="name data-v-f689bf8e">{{row.a}}</text><text class="status data-v-f689bf8e">{{row.b}}</text></view><text class="meta data-v-f689bf8e">{{row.c}} · {{row.d}}</text><view class="packages data-v-f689bf8e"><text wx:for="{{row.e}}" wx:for-item="p" wx:key="e" class="data-v-f689bf8e">{{p.a}}：买{{p.b}}送{{p.c}} · ¥{{p.d}}</text><text wx:if="{{row.f}}" class="empty-inline data-v-f689bf8e">暂无套餐档位</text></view><view class="row-actions data-v-f689bf8e"><button class="data-v-f689bf8e" bindtap="{{row.g}}">查看</button><button wx:if="{{g}}" class="data-v-f689bf8e" bindtap="{{row.h}}">编辑</button><button wx:if="{{h}}" class="data-v-f689bf8e" bindtap="{{row.i}}">同步到其他机构</button></view></view><view wx:if="{{i}}" class="empty data-v-f689bf8e">暂无销售政策</view></view>