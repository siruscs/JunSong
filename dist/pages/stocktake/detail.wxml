<view class="page"><view wx:if="{{a}}" class="load-state">加载盘点任务...</view><view wx:elif="{{b}}" class="load-error"><text class="empty-title">加载失败</text><text class="empty-subtitle">{{c}}</text><button class="retry-button" bindtap="{{d}}">重新加载</button></view><block wx:elif="{{e}}"><view class="header-card"><view class="header-row"><text class="take-no">{{f}}</text><text class="{{['status-tag', h]}}">{{g}}</text></view><view class="header-meta"><text>门店：{{i}}</text><text wx:if="{{j}}">盘点人：{{k}}</text></view><view class="header-meta"><text wx:if="{{l}}">冻结：{{m}}</text><text wx:if="{{n}}">提交：{{o}}</text></view><view wx:if="{{p}}" class="header-meta"><text>冲销原因：{{q}}</text></view></view><view class="action-bar"><button wx:if="{{r}}" class="action-btn primary" disabled="{{s}}" bindtap="{{t}}">启动盘点</button><button wx:if="{{v}}" class="action-btn success" disabled="{{w}}" bindtap="{{x}}">提交盘点</button><button wx:if="{{y}}" class="action-btn success" disabled="{{z}}" bindtap="{{A}}">过账</button><button wx:if="{{B}}" class="action-btn danger-plain" disabled="{{C}}" bindtap="{{D}}">取消</button><button wx:if="{{E}}" class="action-btn danger" disabled="{{F}}" bindtap="{{G}}">整单冲销</button></view><view wx:if="{{H}}" class="blind-notice"> 盲盘模式：期望数量、方差、成本由系统在提交后计算，盘点时不可见。 </view><view class="section-title">行项目（{{I}} 项）</view><view wx:for="{{J}}" wx:for-item="item" wx:key="O" class="item-card"><view class="item-head"><text class="item-name">{{item.a}}</text><text wx:if="{{item.b}}" class="item-counted">已盘点</text></view><view wx:if="{{K}}" class="item-row"><text class="item-label">期望数量</text><text class="item-value">{{item.c}}</text></view><view wx:if="{{L}}" class="item-row"><text class="item-label">冻结后移动</text><text class="item-value">{{item.d}}</text></view><view wx:if="{{item.e}}" class="item-row"><text class="item-label">实际数量</text><input class="item-input" type="digit" placeholder="输入实际数量" value="{{item.f}}" bindinput="{{item.g}}"/></view><view wx:else class="item-row"><text class="item-label">实际数量</text><text class="item-value">{{item.h}}</text></view><view wx:if="{{item.i}}" class="item-row"><text class="item-label">复盘数量</text><input class="item-input" type="digit" placeholder="输入复盘数量" value="{{item.j}}" bindinput="{{item.k}}"/></view><view wx:elif="{{item.l}}" class="item-row"><text class="item-label">复盘数量</text><text class="item-value">{{item.m}}</text></view><view wx:if="{{item.n}}" class="item-row"><text class="item-label">最终数量</text><text class="item-value">{{item.o}}</text></view><view wx:if="{{item.p}}" class="item-row"><text class="item-label">方差数量</text><text class="{{['item-value', item.r]}}">{{item.q}}</text></view><view wx:if="{{item.s}}" class="item-row"><text class="item-label">方差金额</text><text class="{{['item-value', item.v]}}">{{item.t}}</text></view><view wx:if="{{item.w}}" class="item-row"><text class="item-label">原因代码</text><picker class="item-picker" range="{{item.y}}" range-key="label" value="{{item.z}}" bindchange="{{item.A}}"><view class="picker-value">{{item.x}}</view></picker></view><view wx:elif="{{item.B}}" class="item-row"><text class="item-label">原因</text><text class="item-value">{{item.C}}</text></view><view wx:if="{{item.D}}" class="item-row"><text class="item-label">原因说明</text><input class="item-input" type="text" placeholder="选填，原因说明" maxlength="200" value="{{item.E}}" bindinput="{{item.F}}"/></view><view wx:if="{{item.G}}" class="item-actions"><button class="save-btn" disabled="{{item.I}}" bindtap="{{item.J}}">{{item.H}}</button></view><view wx:if="{{item.K}}" class="item-actions"><button class="save-btn" disabled="{{item.M}}" bindtap="{{item.N}}">{{item.L}}</button></view></view><view class="section-title">操作历史</view><view wx:for="{{M}}" wx:for-item="h" wx:key="i" class="history-card"><view class="history-head"><text class="history-action">{{h.a}}</text><text class="history-time">{{h.b}}</text></view><view wx:if="{{h.c}}" class="history-transition">{{h.d}} → {{h.e}}</view><view class="history-operator">操作人：{{h.f}}</view><view wx:if="{{h.g}}" class="history-comment">{{h.h}}</view></view><view wx:if="{{N}}" class="empty"><text class="empty-subtitle">暂无历史记录</text></view></block><view wx:if="{{O}}" class="dialog-mask" bindtap="{{P}}"></view><view wx:if="{{Q}}" class="dialog-panel"><view class="dialog-title">整单冲销</view><view class="dialog-warning"> 冲销将生成红字库存与成本台账，撤回本次盘点过账影响。该操作不可撤销。 </view><view class="dialog-field"><text class="dialog-label">冲销原因</text><block wx:if="{{r0}}"><textarea class="dialog-textarea" placeholder="请输入冲销原因（必填）" maxlength="500" value="{{R}}" bindinput="{{S}}"/></block></view><view class="dialog-field"><text class="dialog-label">幂等键</text><input class="dialog-input" placeholder="幂等键（必填）" value="{{T}}" bindinput="{{U}}"/></view><view class="dialog-actions"><button class="dialog-btn" bindtap="{{V}}">取消</button><button class="dialog-btn danger" disabled="{{W}}" bindtap="{{X}}">确认冲销</button></view></view></view>