{
  "openapi": "3.1.0",
  "info": {
    "title": "Genesis Cloud Open Platform API",
    "description": "Genesis Cloud 开放平台公共 API v1。所有外部可调用能力都必须经过网关签名校验。",
    "version": "1.0.0",
    "contact": {
      "name": "Genesis Cloud Open Platform"
    }
  },
  "servers": [
    {
      "url": "/openapi/v1",
      "description": "v1 公共 API 前缀（生产环境由网关路由决定）"
    }
  ],
  "security": [
    { "appKeySignature": [] }
  ],
  "tags": [
    { "name": "member", "description": "会员能力：会员查询、积分、兑换和运营看板" },
    { "name": "workflow", "description": "流程能力：流程定义、实例发起、任务处理和历史查询" },
    { "name": "request", "description": "业务申请能力：门店开办申请查询、创建、提交和撤回" },
    { "name": "foundation", "description": "平台基础能力：应用管理、Key 管理和 Webhook 订阅" }
  ],
  "paths": {
    "/members": {
      "get": {
        "operationId": "listMembers",
        "summary": "查询会员列表",
        "tags": ["member"],
        "security": [{ "appKeySignature": [] }],
        "parameters": [
          { "name": "pageNum", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "memberNo", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "memberName", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
