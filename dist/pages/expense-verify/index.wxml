<view class="page data-v-60839d43"><view wx:if="{{a}}" class="load-state data-v-60839d43">正在加载核销数据...</view><view wx:elif="{{b}}" class="load-error data-v-60839d43"><text class="load-error-title data-v-60839d43">核销数据加载失败</text><text class="load-error-message data-v-60839d43">{{c}}</text><button class="retry data-v-60839d43" bindtap="{{d}}">重新加载</button></view><block wx:else><view class="summary-card data-v-60839d43"><view class="title data-v-60839d43">核销汇总</view><view class="row data-v-60839d43"><text class="data-v-60839d43">费用（{{e}}笔）</text><text class="data-v-60839d43">¥{{f}}</text></view><view class="row data-v-60839d43"><text class="data-v-60839d43">借支（{{g}}笔）</text><text class="data-v-60839d43">¥{{h}}</text></view><view class="row difference data-v-60839d43"><text class="data-v-60839d43">差额</text><text class="data-v-60839d43">¥{{i}}</text></view><view class="explanation data-v-60839d43">{{j}}</view></view><view class="section-title data-v-60839d43">待核销费用</view><view wx:for="{{k}}" wx:for-item="item" wx:key="c" class="card data-v-60839d43"><text class="data-v-60839d43">{{item.a}}</text><text class="data-v-60839d43">¥{{item.b}}</text></view><view class="section-title data-v-60839d43">选择借支单</view><view wx:if="{{l}}" class="notice data-v-60839d43">{{m}}</view><view wx:if="{{n}}" class="empty data-v-60839d43">当前门店暂无未核销借支单</view><view wx:for="{{o}}" wx:for-item="item" wx:key="g" class="{{['card', 'selectable', 'data-v-60839d43', item.f && 'selected']}}" bindtap="{{item.h}}"><text class="check data-v-60839d43">{{item.a}}</text><view class="grow data-v-60839d43"><text class="data-v-60839d43">{{item.b}}</text><text class="meta data-v-60839d43">{{item.c}} {{item.d}}</text></view><text class="data-v-60839d43">¥{{item.e}}</text></view><button class="submit data-v-60839d43" disabled="{{q}}" bindtap="{{r}}">{{p}}</button></block></view>