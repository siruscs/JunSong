<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.junsong.open.mapper.OpenAppMapper">

    <resultMap type="OpenApp" id="OpenAppResult">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="appName" column="app_name"/>
        <result property="appType" column="app_type"/>
        <result property="description" column="description"/>
        <result property="websiteUrl" column="website_url"/>
        <result property="callbackUrl" column="callback_url"/>
        <result property="contactName" column="contact_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="contactEmail" column="contact_email"/>
        <result property="status" column="status"/>
        <result property="rejectReason" column="reject_reason"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectOpenAppVo">
        select id, tenant_id, app_name, app_type, description, website_url, callback_url,
               contact_name, contact_phone, contact_email, status, reject_reason,
               del_flag, create_by, create_time, update_by, update_time, remark
        from open_app
    </sql>

    <select id="selectOpenAppList" parameterType="OpenApp" resultMap="OpenAppResult">
        <include refid="selectOpenAppVo"/>
        <where>
            del_flag = '0'
            <if test="tenantId != null">and tenant_id = #{tenantId}</if>
            <if test="appName != null and appName != ''">and app_name like concat('%', #{appName}, '%')</if>
            <if test="appType != null and appType != ''">and app_type = #{appType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="createBy != null and createBy != ''">and create_by = #{createBy}</if>
        </where>
        order by id desc
    </select>

    <select id="selectOpenAppById" parameterType="Long" resultMap="OpenAppResult">
        <include refid="selectOpenAppVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <insert id="insertOpenApp" parameterType="OpenApp" useGeneratedKeys="true" keyProperty="id">
        insert into open_app
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantId != null">tenant_id,</if>
            <if test="appName != null and appName != ''">app_name,</if>
            <if test="appType != null and appType != ''">app_type,</if>
            <if test="description != null">description,</if>
            <if test="websiteUrl != null">website_url,</if>
            <if test="callbackUrl != null">callback_url,</if>
            <if test="contactName != null">contact_name,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="contactEmail != null">contact_email,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="rejectReason != null">reject_reason,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tenantId != null">#{tenantId},</if>
            <if test="appName != null and appName != ''">#{appName},</if>
            <if test="appType != null and appType != ''">#{appType},</if>
            <if test="description != null">#{description},</if>
            <if test="websiteUrl != null">#{websiteUrl},</if>
            <if test="callbackUrl != null">#{callbackUrl},</if>
            <if test="contactName != null">#{contactName},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="contactEmail != null">#{contactEmail},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="rejectReason != null">#{rejectReason},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateOpenApp" parameterType="OpenApp">
        update open_app
        <trim prefix="SET" suffixOverrides=",">
            <if test="appName != null and appName != ''">app_name = #{appName},</if>
            <if test="appType != null and appType != ''">app_type = #{appType},</if>
            <if test="description != null">description = #{description},</if>
            <if test="websiteUrl != null">website_url = #{websiteUrl},</if>
            <if test="callbackUrl != null">callback_url = #{callbackUrl},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="contactEmail != null">contact_email = #{contactEmail},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOpenAppById" parameterType="Long">
        update open_app set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteOpenAppByIds" parameterType="Long">
        update open_app set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
