# 基础镜像
FROM eclipse-temurin:17
# author
MAINTAINER junsong

# 安装 RapidOCR 运行依赖：Python3 + pip + RapidOCR(ONNX) + libGL
# RapidOCR 是 PaddleOCR 的 ONNX 轻量版，无需 PaddlePaddle，CPU 即可运行，中文识别精度远超 Tesseract
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-setuptools libgl1 libglib2.0-0 \
    && pip3 install --no-cache-dir --break-system-packages rapidocr-onnxruntime \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip

# 创建目录
RUN mkdir -p /home/junsong
# 指定路径
WORKDIR /home/junsong
# 复制jar文件到路径
COPY ./jar/junsong-modules-finance.jar /home/junsong/junsong-modules-finance.jar
# 启动财务服务
ENTRYPOINT ["java","-jar","junsong-modules-finance.jar"]
